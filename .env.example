# Points the portal at the service-application API (PORT=4100, API_PREFIX=api, versioned /v1).
# The API's CORS_ORIGINS already allows http://localhost:5173.
VITE_API_URL=http://localhost:4100/api/v1

# The portal's public address, e.g. https://sales.pronttera.com. Used for the link-preview
# (Open Graph) banner when a link is shared on WhatsApp etc. Falls back to Vercel's production
# domain; build-time only.
# VITE_APP_URL=

# Optional: map tile server (defaults to OpenStreetMap)
# VITE_MAP_TILE_URL=
